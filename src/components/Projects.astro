---
import { PROJECTS } from "../const";
import SectionDivider from "./SectionDivider.astro";

const projects = PROJECTS.filter((p) => !p.hidden).reverse();
---

<section id="projects" class="reveal" style="--i: 1" aria-labelledby="projects-title">
  <div class="wrap">
    <SectionDivider title="Work index" note="Selected · 4 entries" />
    <ol class="index">
      {projects.map((project, i) => {
        const num = String(projects.length - i).padStart(2, "0");
        return (
          <li class="row">
            <span class="row__num" aria-hidden="true">{num}</span>
            <div class="row__body">
              <h3 class="row__title">
                <a href={project.link} target="_blank" rel="nofollow noopener noreferrer">{project.title}</a>
              </h3>
              <p class="row__desc">{project.description}</p>
              <p class="row__tech">{project.tech.join(" · ")}</p>
            </div>
            <div class="row__links">
              {project.code && (
                <a class="row__action" href={`https://github.com/jeantigreros/${project.slug}`} target="_blank" rel="noopener noreferrer">Code →</a>
              )}
              <a class="row__action" href={project.link} target={project.link.startsWith("http") ? "_blank" : undefined} rel="nofollow noopener noreferrer">
                {project.demo ? "Demo ↗" : "Open ↗"}
              </a>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .wrap { max-width: 72rem; margin-inline: auto; padding: 0 var(--space-md); }
  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-rule-2); }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-sm);
    padding: var(--space-lg) 0;
    border-bottom: 1px solid var(--color-rule);
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .row:hover { background: color-mix(in oklch, var(--color-paper-2) 60%, transparent); }
  .row__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .row__body { min-width: 0; }
  .row__title { margin: 0 0 var(--space-xs); font-family: var(--font-display); font-style: normal; font-weight: 700; font-size: var(--text-lg); letter-spacing: -0.02em; line-height: 1.2; overflow-wrap: anywhere; min-width: 0; }
  .row__title a { color: var(--color-ink); text-decoration: none; }
  .row__title a:hover { color: var(--color-accent); }
  .row__desc { margin: 0 0 var(--space-sm); color: var(--color-ink-2); font-size: var(--text-base); line-height: 1.6; max-width: 65ch; }
  .row__tech { margin: 0; font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.04em; color: var(--color-muted); }
  .row__links { display: flex; flex-wrap: wrap; gap: var(--space-md); align-content: start; }
  .row__action {
    font-size: var(--text-sm); font-weight: 600;
    color: var(--color-ink); text-decoration: none;
    border-bottom: 1px solid var(--color-rule-2);
    padding-bottom: 2px;
    white-space: nowrap; min-height: 44px;
    display: inline-flex; align-items: center;
  }
  .row__action:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  @media (min-width: 60rem) {
    .row { grid-template-columns: minmax(0, 4rem) minmax(0, 1fr) minmax(0, 11rem); gap: var(--space-lg); }
    .row__links { flex-direction: column; align-items: flex-end; gap: var(--space-sm); }
  }
</style>
