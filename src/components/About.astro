---
import Card from "./Card.astro";
import SectionDivider from "./SectionDivider.astro";
import AstroIcon from "./icons/Astro.astro";
import NextjsIcon from "./icons/Nextjs.astro";
import ReactIcon from "./icons/React.astro";
import TailwindIcon from "./icons/Tailwind.astro";
import CssIcon from "./icons/Css.astro";
import HtmlIcon from "./icons/Html.astro";
import JavascriptIcon from "./icons/Javascript.astro";
import TypescriptIcon from "./icons/Typescript.astro";
import PythonIcon from "./icons/Python.astro";
import NodeIcon from "./icons/Node.astro";
import LinuxIcon from "./icons/Linux.astro";
import GitIcon from "./icons/Git.astro";
import SqlIcon from "./icons/Sql.astro";
import PandasIcon from "./icons/Pandas.astro";

const date = new Date()
let year = date.getFullYear()
let age = year - 2003
---

<section id="about" class="reveal" style="--i: 2" aria-labelledby="about-title">
  <div class="wrap">
    <SectionDivider title="About me" note="Palmira · UNAD · freelance" />
    <Card>
      <div class="about__bio">
        <h3 class="about__name" id="about-title">Jean Carlos Tigreros</h3>
        <p>Hi, I'm {age} and I study engineering at Universidad Nacional Abierta y a Distancia, in Palmira, Colombia. I'm an engineer focused on data engineering and application development: I build ETL pipelines, clean and model data with Python, SQL, and Pandas, and ship it in Parquet-ready, analysis-ready form.</p>
        <p>Outside of development: video games, philosophy, photography, and working out.</p>
        <p class="about__social">
          <a href="https://github.com/jeantigreros" target="_blank" rel="noopener">GitHub →</a>
          <a href="https://x.com/nekro24" target="_blank" rel="noopener">X →</a>
          <a href="https://co.linkedin.com/in/jean-carlos-tigreros-0187b12b5" target="_blank" rel="noopener">LinkedIn ↗</a>
        </p>
      </div>
      <div class="about__skills">
        <h3 class="about__h">Stack</h3>
        <ul class="skills">
          <li><AstroIcon /></li>
          <li><NextjsIcon /></li>
          <li><ReactIcon /></li>
          <li><CssIcon /></li>
          <li><JavascriptIcon /></li>
          <li><TypescriptIcon /></li>
          <li><HtmlIcon /></li>
          <li><TailwindIcon /></li>
          <li><PythonIcon /></li>
          <li><SqlIcon /></li>
          <li><PandasIcon /></li>
          <li><NodeIcon /></li>
          <li><LinuxIcon /></li>
          <li><GitIcon /></li>
        </ul>
      </div>
    </Card>
  </div>
</section>

<style>
  .wrap { max-width: 72rem; margin-inline: auto; padding: 0 var(--space-md); }
  .about__bio p { color: var(--color-ink-2); font-size: var(--text-md); line-height: 1.65; max-width: 65ch; margin: 0 0 var(--space-md); }
  .about__name {
    font-family: var(--font-display); font-style: normal; font-weight: 700;
    font-size: var(--text-xl); letter-spacing: -0.02em; line-height: 1.15;
    color: var(--color-ink); margin: 0 0 var(--space-md);
    overflow-wrap: anywhere; min-width: 0;
  }
  .about__h {
    font-family: var(--font-mono); font-size: var(--text-xs);
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-muted); margin: 0 0 var(--space-md);
  }
  .about__social { display: flex; flex-wrap: wrap; gap: var(--space-md); }
  .about__social a { color: var(--color-accent); font-weight: 600; font-size: var(--text-base); white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; }
  .skills {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--space-sm);
  }
  .skills li {
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-2);
    min-width: 0;
  }
  .skills :global(svg) { width: 1.4rem; height: 1.4rem; display: block; margin-bottom: var(--space-2xs); }
  .skills :global(div) { display: flex; flex-direction: column; align-items: flex-start; gap: 0; }
</style>
