---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import evidence from "../../assets/overlay-actualizacion-falsa.png";
import Layout from "../../layouts/Layout.astro";
import "../../styles/blog.css";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const base = import.meta.env.BASE_URL;
const postHref = (id: string) => `${base}/blog/${id}/`;
const dateFmt = new Intl.DateTimeFormat("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
---

<Layout
  title="Blog, Jean Tigreros"
  description="Reportes técnicos de seguridad, sistemas y datos, escritos por Jean Tigreros."
  lang="es"
>
  <section class="listing" aria-labelledby="listing-title">
    <div class="listing__text">
      <div class="listing__head">
        <h1 id="listing-title">algunas cosas que escribo</h1>
        <p>Reportes técnicos de seguridad, sistemas y datos. Lo más reciente primero.</p>
      </div>

      {posts.map((post) => (
        <article class="entry">
          <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <a class="entry__more" href={postHref(post.id)}>Leer el reporte</a>
        </article>
      ))}
    </div>

    <figure class="cover">
      <Image
        src={evidence}
        widths={[320, 480, 720, 960]}
        sizes="(min-width: 60rem) 26vw, 80vw"
        alt="Aviso falso de actualización del sistema dibujado por el troyano: logo de Android, versión 12.0.0.149, rueda de progreso al 62% y el texto Downloading system updates."
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>La superposición falsa sobre Nequi, capturada el 26 de octubre de 2026 a las 20:15 (America/Bogota).</figcaption>
    </figure>
  </section>
</Layout>
