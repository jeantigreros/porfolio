---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import Layout from "./Layout.astro";
import "../styles/blog.css";

type Props = CollectionEntry<"blog">["data"] & { headings?: MarkdownHeading[] };

const { title, description, pubDate, heroImage, headings = [] } = Astro.props;

const dateFmt = new Intl.DateTimeFormat("es-CO", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const dateLabel = dateFmt.format(pubDate);

const tocLabel = (text: string) =>
  text === "Estado actual del dispositivo y de la contención"
    ? "Estado del dispositivo"
    : text;
const contents = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ ...h, label: tocLabel(h.text) }));

---

<Layout
  title={title}
  description={description}
  image={heroImage?.src}
  type="article"
  lang="es"
>
  <article>
    <header class="post-hero">
      <div class="post-hero__text">
        <p class="post-hero__meta">
          <time datetime={pubDate.toISOString()}>{dateLabel}</time>
        </p>
        <h1>{title}</h1>
      </div>
    </header>

    <div class="post-body">
      <div class="article-wrap">
        <details class="toc-mobile">
          <summary>Contenido</summary>
          <ol>
            {contents.map((h) => (
              <li><a href={`#${h.slug}`}>{h.label}</a></li>
            ))}
          </ol>
        </details>

        <div class="prose">
          <slot />
        </div>
      </div>

      <nav class="toc" aria-label="Contenido del reporte">
        <p class="toc__title">Contenido</p>
        <ol>
          {contents.map((h) => (
            <li><a href={`#${h.slug}`}>{h.label}</a></li>
          ))}
        </ol>
      </nav>
    </div>
  </article>
</Layout>
